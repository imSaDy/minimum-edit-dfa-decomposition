digraph DFA {
  rankdir=LR;
  __start [shape=point, label=""];
  __start -> q0;
  q0 [shape=circle, label="q0"];
  q1 [shape=circle, label="q1"];
  q2 [shape=doublecircle, label="q2"];
  q0 -> q0 [label="a"];
  q0 -> q1 [label="b"];
  q1 -> q0 [label="a"];
  q1 -> q2 [label="b"];
  q2 -> q0 [label="a"];
  q2 -> q0 [label="b"];
}
