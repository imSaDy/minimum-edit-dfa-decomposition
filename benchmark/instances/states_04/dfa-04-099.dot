digraph DFA {
  rankdir=LR;
  __start [shape=point, label=""];
  __start -> q0;
  q0 [shape=circle, label="0"];
  q1 [shape=circle, label="1"];
  q2 [shape=doublecircle, label="2"];
  q3 [shape=circle, label="3"];
  q0 -> q0 [label="a"];
  q0 -> q1 [label="b"];
  q1 -> q2 [label="a"];
  q1 -> q0 [label="b"];
  q2 -> q3 [label="a"];
  q2 -> q2 [label="b"];
  q3 -> q3 [label="a"];
  q3 -> q3 [label="b"];
}
